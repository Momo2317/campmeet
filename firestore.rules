rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Erlaubte Uni-Domains (identisch zu FirebaseConfig.germanUniversityDomains)
    function universityDomains() {
      return ['tum.de', 'kit.edu', 'rwth-aachen.de', 'tu-berlin.de', 'tu-dortmund.de', 'tu-braunschweig.de', 'tu-ilmenau.de', 'tu-chemnitz.de', 'uni-hannover.de', 'uni-kl.de', 'lmu.de', 'uni-heidelberg.de', 'uni-bonn.de', 'uni-cologne.de', 'uni-freiburg.de', 'uni-tuebingen.de', 'uni-goettingen.de', 'uni-marburg.de', 'uni-mainz.de', 'uni-mannheim.de', 'uni-hamburg.de', 'uni-frankfurt.de', 'uni-leipzig.de', 'uni-greifswald.de', 'uni-potsdam.de', 'hu-berlin.de', 'fu-berlin.de', 'uni-wuppertal.de', 'uni-jena.de', 'uni-muenster.de', 'uni-duesseldorf.de'];
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/admin/config).data.admins[request.auth.uid] == true;
    }

    // Users Collection
    match /users/{userId} {
      // Users can read their own document
      // Anyone can read public verification status
      allow read: if isAuthenticated() &&
                     (request.auth.uid == userId ||
                      resource.data.isVerified == true);

      // Users can only update their own document
      // They cannot modify verification fields
      allow update: if isAuthenticated() &&
                       request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'verificationMethod', 'verificationDate', 'verificationRequestId']);

      // Only allow create on signup
      // Neue Konten dürfen sich nicht selbst verifizieren
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                       request.resource.data.get('isVerified', false) == false;

      // Uni-Mail-Verifizierung: nur mit bestätigter Mail-Adresse (E-Mail-Link
      // oder Google) und Domain aus der Uni-Liste
      allow update: if isAuthenticated() &&
                       request.auth.uid == userId &&
                       request.auth.token.email_verified == true &&
                       request.auth.token.email.split('@')[1] in universityDomains() &&
                       request.resource.data.isVerified == true &&
                       request.resource.data.verificationMethod == 'email' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['isVerified', 'verificationMethod', 'verificationDate']);

      // Admins dürfen den Verifizierungsstatus setzen
      allow update: if isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();

      // Verification Requests Subcollection
      match /verificationRequests/{requestId} {
        allow read: if isAuthenticated() &&
                       (request.auth.uid == userId || isAdmin());
        allow create: if isAuthenticated() && request.auth.uid == userId &&
                         request.resource.data.status == 'pending' &&
                         request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin(); // Only admins can approve/reject
        allow delete: if isAdmin();
      }
    }

    // Verification Requests Collection (global index)
    match /verificationRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false; // Use subcollection instead
    }

    // University Domains Whitelist
    match /universityDomains/{domainId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Verification Audit Log
    match /verificationAuditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow write: if false;
    }

    // Chat Collections (existing)
    match /users/{userId}/chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Matches Collection (existing)
    match /matches/{matchId} {
      allow read: if isAuthenticated() &&
                     request.auth.uid in resource.data.userIds;
      allow create: if isAuthenticated() &&
                       request.auth.uid in request.resource.data.userIds;
      allow update, delete: if isAuthenticated() &&
                               request.auth.uid in resource.data.userIds &&
                               request.auth.uid in request.resource.data.userIds;
    }

    // WG & Zimmer: Anzeigen (öffentlich lesbar, nur Besitzer darf ändern)
    match /wgListings/{listingId} {
      allow read: if isAuthenticated() &&
                     (resource.data.status == 'active' &&
                      resource.data.expiresAt > request.time ||
                      resource.data.ownerId == request.auth.uid);
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.warmRent is int &&
                       request.resource.data.warmRent > 0 &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() >= 5 &&
                       request.resource.data.title.size() <= 80;
      allow update: if isAuthenticated() &&
                       resource.data.ownerId == request.auth.uid &&
                       request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() &&
                       (resource.data.ownerId == request.auth.uid || isAdmin());

      // Meldungen: jeder Angemeldete darf eine Meldung anlegen, nur Admins lesen
      match /reports/{reporterId} {
        allow create: if isAuthenticated() && reporterId == request.auth.uid;
        allow read, update, delete: if isAdmin();
      }
    }

    // Storage Rules (in storage.rules)
  }
}
